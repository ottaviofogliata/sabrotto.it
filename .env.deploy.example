# Copy this file to .env.deploy and fill in the real values.
# .env.deploy is ignored by git.

SSH_USER=root
SSH_HOST=203.0.113.10
SSH_PORT=22
SSH_PASSWORD=change-me

DOMAIN=example.it
APP_PORT=3000

# Required by the production minigame score API. Generate with:
# openssl rand -hex 32
MINIGAME_SCORE_SECRET=replace-with-a-long-random-secret

# Optional overrides:
# SSH_KEY_PATH=/Users/you/.ssh/ssh_somewhere_key
# REMOTE_APP_USER=www-data
# SERVICE_NAME=example.it
# INCLUDE_WWW=1
# REMOTE_INSTALL_NODE=1
# SSH_STRICT_HOST_KEY=accept-new
